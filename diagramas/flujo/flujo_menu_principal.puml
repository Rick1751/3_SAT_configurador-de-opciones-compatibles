@startuml
title Menú principal (13 opciones)
start
:mostrar opciones 1..13;
:leer entero con reintento;
if (entrada válida 1..13?) then (sí)
  if (opción 13?) then (sí)
    stop
  else (no)
    :ejecutar opción;
    if (error controlado?) then (sí)
      :mostrar mensaje amigable;
    endif
  endif
else (no)
  :mostrar "Ingrese un número entero";
endif
:volver al menú;
repeat
@enduml
